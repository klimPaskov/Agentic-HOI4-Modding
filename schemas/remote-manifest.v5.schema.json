{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://klimpaskov.github.io/hoi4-mod-setup/schemas/remote-manifest.v5.schema.json",
  "title": "HOI4 Mod Setup Remote Manifest v5",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_id",
    "generated_for_revision",
    "repository",
    "components",
    "profiles",
    "wiki",
    "update_policy",
    "coding_environments",
    "image_generation"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^5\\.[0-9]+\\.[0-9]+$"
    },
    "manifest_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "generated_for_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "repository": {
      "$ref": "#/$defs/repository"
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/component"
      }
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/profile"
      }
    },
    "wiki": {
      "$ref": "#/$defs/wiki"
    },
    "update_policy": {
      "$ref": "#/$defs/updatePolicy"
    },
    "signing": {
      "$ref": "#/$defs/signing"
    },
    "coding_environments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/codingEnvironment"
      }
    },
    "image_generation": {
      "$ref": "#/$defs/imageGeneration"
    },
    "live_testing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "default_provider",
        "providers"
      ],
      "properties": {
        "default_provider": {
          "enum": [
            "clausewitz_mcp",
            "hoi4_live_tools",
            "none"
          ]
        },
        "providers": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "display_name",
              "description",
              "requirements",
              "documentation_url",
              "supported_platforms",
              "supported_coding_environments",
              "experimental",
              "route",
              "guidance",
              "supported_game_version",
              "attribution"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "display_name": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "documentation_url": {
                "type": "string",
                "minLength": 1
              },
              "supported_game_version": {
                "type": "string",
                "minLength": 1
              },
              "requirements": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "guidance": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "supported_platforms": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "windows",
                    "macos",
                    "linux"
                  ]
                }
              },
              "supported_coding_environments": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "claude_code",
                    "codex",
                    "cursor",
                    "qoder",
                    "opencode"
                  ]
                }
              },
              "experimental": {
                "type": "boolean"
              },
              "route": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "server_id",
                  "component_id",
                  "source_repository",
                  "source_revision"
                ],
                "properties": {
                  "kind": {
                    "enum": [
                      "external_stdio",
                      "local_install",
                      "manual"
                    ]
                  },
                  "server_id": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "component_id": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "source_repository": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "source_revision": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                }
              },
              "attribution": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "author",
                  "url",
                  "license",
                  "license_url"
                ],
                "properties": {
                  "author": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "url": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "license": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "license_url": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "owner",
        "name",
        "default_branch"
      ],
      "properties": {
        "provider": {
          "const": "github"
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "default_branch": {
          "type": "string",
          "minLength": 1
        },
        "web_url": {
          "type": "string",
          "format": "uri"
        },
        "api_base": {
          "type": "string",
          "format": "uri"
        },
        "license_evidence": {
          "enum": [
            "verified",
            "declared_unverified",
            "not_found",
            "unknown"
          ]
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "path"
      ],
      "properties": {
        "kind": {
          "enum": [
            "file",
            "tree",
            "generated"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "include": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "exclude": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "template_engine": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "destination": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "ownership"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "ownership": {
          "enum": [
            "managed",
            "merged",
            "generated",
            "external"
          ]
        },
        "outside_project": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "required"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "required": {
          "type": "boolean"
        },
        "version_policy": {
          "enum": [
            "manifest",
            "repository_script",
            "latest_at_execution",
            "user_managed",
            "any"
          ]
        },
        "version": {
          "type": [
            "string",
            "null"
          ]
        },
        "commands": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "health_checks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "env": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "secret",
        "required"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "secret": {
          "type": "boolean"
        },
        "required": {
          "type": "boolean"
        },
        "storage": {
          "enum": [
            "process",
            "os_credential_vault",
            "user_environment",
            "project_file_forbidden"
          ]
        },
        "non_empty": {
          "type": "boolean"
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "severity",
        "kind"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "severity": {
          "enum": [
            "block",
            "warn",
            "info"
          ]
        },
        "kind": {
          "enum": [
            "exists",
            "sha256",
            "json_schema",
            "toml_parse",
            "yaml_bom",
            "command",
            "directory_coverage",
            "custom"
          ]
        },
        "target": {
          "type": [
            "string",
            "null"
          ]
        },
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "executable_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "executable_size": {
              "type": "integer",
              "minimum": 0
            },
            "interpreter_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "interpreter_size": {
              "type": "integer",
              "minimum": 0
            },
            "runtime_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "runtime_size": {
              "type": "integer",
              "minimum": 0
            },
            "package_name": {
              "type": "string",
              "maxLength": 128
            },
            "package_version": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
            },
            "package_root": {
              "type": "string",
              "maxLength": 512
            },
            "script_path": {
              "type": "string",
              "maxLength": 512
            },
            "source_revision": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "source_tree_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "package_lock_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "package_integrity": {
              "type": "string",
              "pattern": "^sha512-[A-Za-z0-9+/]+={0,2}$",
              "maxLength": 256
            },
            "package_tree_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "package_file_count": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000
            },
            "runtime_entry": {
              "type": "string",
              "maxLength": 256
            },
            "runtime_entry_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "runtime_entry_size": {
              "type": "integer",
              "minimum": 1
            },
            "required_tools": {
              "type": "array",
              "minItems": 1,
              "maxItems": 4096,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^(hoi4\\.[a-z0-9_]+|generate_image|image_auth_status)$",
                "maxLength": 256
              }
            },
            "arguments": {
              "type": "array",
              "maxItems": 32,
              "items": {
                "type": "string",
                "maxLength": 4096
              }
            },
            "network_access": {
              "type": "string",
              "maxLength": 4096
            },
            "expected_writes": {
              "type": "array",
              "maxItems": 64,
              "items": {
                "type": "string",
                "maxLength": 4096
              }
            },
            "privilege": {
              "type": "string",
              "maxLength": 256
            },
            "rollback_boundary": {
              "type": "string",
              "maxLength": 4096
            },
            "release_version": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
            },
            "release_url": {
              "type": "string",
              "pattern": "^https://github\\.com/[A-Za-z0-9._-]+/[A-Za-z0-9._-]+/releases/download/[A-Za-z0-9._/-]+\\.zip$",
              "maxLength": 512
            },
            "release_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "release_size": {
              "type": "integer",
              "minimum": 1
            },
            "platform_targets": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "windows",
                "linux"
              ],
              "properties": {
                "windows": {
                  "const": "hoi4-agent-tools.cmd"
                },
                "linux": {
                  "const": "hoi4-agent-tools"
                }
              }
            },
            "platform_pins": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "windows",
                "linux"
              ],
              "properties": {
                "windows": {
                  "$ref": "#/$defs/mcpPlatformPin"
                },
                "linux": {
                  "$ref": "#/$defs/mcpPlatformPin"
                }
              }
            }
          }
        }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "display_name",
        "category",
        "optional",
        "platforms",
        "source",
        "destination",
        "dependencies",
        "expected_files",
        "conflict_policy",
        "validation",
        "update"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$",
          "maxLength": 128
        },
        "display_name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "category": {
          "enum": [
            "core",
            "environment",
            "skill",
            "subagent",
            "codex",
            "mcp",
            "script",
            "validator",
            "template",
            "documentation",
            "wiki",
            "workflow"
          ]
        },
        "coding_environment": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "optional": {
          "type": "boolean"
        },
        "platforms": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "windows",
              "macos",
              "all",
              "linux"
            ]
          }
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "destination": {
          "$ref": "#/$defs/destination"
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "required_tools": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/tool"
          }
        },
        "environment": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/env"
          }
        },
        "expected_files": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256",
              "size"
            ],
            "properties": {
              "path": {
                "type": "string"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "size": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "conflicts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "conflict_policy": {
          "enum": [
            "fail",
            "prompt",
            "three_way_merge",
            "toml_merge",
            "keep_local",
            "replace_if_unmodified",
            "generated_review"
          ]
        },
        "validation": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/validation"
          }
        },
        "update": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "strategy",
            "remove_obsolete"
          ],
          "properties": {
            "strategy": {
              "enum": [
                "replace_if_unmodified",
                "three_way_merge",
                "toml_merge",
                "recreate",
                "repository_script",
                "manual"
              ]
            },
            "remove_obsolete": {
              "type": "boolean"
            },
            "preserve_local_additions": {
              "type": "boolean"
            }
          }
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "display_name",
        "components"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "display_name": {
          "type": "string"
        },
        "components": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "default": {
          "type": "boolean"
        }
      }
    },
    "wiki": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component_id",
        "destination",
        "required_pages",
        "provenance"
      ],
      "properties": {
        "component_id": {
          "type": "string"
        },
        "destination": {
          "const": "paradox_wiki/"
        },
        "snapshot_marker": {
          "type": [
            "string",
            "null"
          ]
        },
        "required_pages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "required_media_policy": {
          "enum": [
            "all_declared",
            "referenced_only",
            "none"
          ]
        },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source_status",
            "license_status"
          ],
          "properties": {
            "source_status": {
              "enum": [
                "verified",
                "repository_only",
                "unknown"
              ]
            },
            "license_status": {
              "enum": [
                "verified",
                "not_found",
                "unknown"
              ]
            },
            "notes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "updatePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "latest",
        "pinned",
        "rollback_retention"
      ],
      "properties": {
        "latest": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "resolve_default_branch",
            "record_commit"
          ],
          "properties": {
            "resolve_default_branch": {
              "const": true
            },
            "record_commit": {
              "const": true
            }
          }
        },
        "pinned": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "allow_commit",
            "allow_release"
          ],
          "properties": {
            "allow_commit": {
              "type": "boolean"
            },
            "allow_release": {
              "type": "boolean"
            }
          }
        },
        "rollback_retention": {
          "type": "integer",
          "minimum": 1
        },
        "manifest_cache_ttl_seconds": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "signing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "required": {
          "type": "boolean"
        },
        "algorithm": {
          "type": [
            "string",
            "null"
          ]
        },
        "public_key_id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "codingEnvironment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "display_name"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "display_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "description": {
          "type": "string",
          "maxLength": 300
        },
        "default_primary": {
          "type": "boolean"
        },
        "open_command": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]{1,64}$"
        }
      }
    },
    "imageGeneration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "default_provider",
        "providers"
      ],
      "properties": {
        "default_provider": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "providers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/imageGenerationProvider"
          }
        }
      }
    },
    "imageGenerationProvider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "display_name",
        "description",
        "availability",
        "requirements",
        "good_for",
        "cost_summary",
        "models",
        "supported_coding_environments",
        "route",
        "capabilities"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "display_name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "availability": {
          "enum": [
            "supported",
            "conditional",
            "manual_only"
          ]
        },
        "requirements": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "good_for": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "cost_summary": {
          "type": "string",
          "minLength": 1
        },
        "documentation_url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "models": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "supported_coding_environments": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          }
        },
        "route": {
          "$ref": "#/$defs/imageGenerationRoute"
        },
        "capabilities": {
          "$ref": "#/$defs/imageGenerationCapabilities"
        },
        "reference_mcp": {
          "$ref": "#/$defs/imageGenerationReferenceMcp"
        }
      }
    },
    "imageGenerationRoute": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "auth_method",
        "server_id",
        "tool_names",
        "supported_models"
      ],
      "properties": {
        "kind": {
          "enum": [
            "local_package",
            "stdio_adapter",
            "remote_http",
            "native",
            "manual"
          ]
        },
        "auth_method": {
          "enum": [
            "chatgpt_subscription",
            "api_key_vault",
            "oauth",
            "cloud_credentials",
            "enterprise_credentials",
            "local",
            "none",
            "manual"
          ]
        },
        "server_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-z][a-z0-9_-]*$"
        },
        "url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "component_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "source_repository": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "source_revision": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{40}$"
        },
        "package_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "package_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "package_tree_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "source_tree_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "package_lock_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "runtime_entry": {
          "type": [
            "string",
            "null"
          ]
        },
        "tool_names": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "supported_models": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "tool_arguments": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required_environment_names": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]*$"
          }
        },
        "auth_headers": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          }
        },
        "api_protocol": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "api_base_url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "default_model": {
          "type": [
            "string",
            "null"
          ]
        },
        "result_format": {
          "enum": [
            "png",
            "jpeg",
            "model_defined",
            "manual"
          ]
        },
        "credential_fields": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "display_name",
              "environment_name"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "display_name": {
                "type": "string"
              },
              "environment_name": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9_]*$"
              },
              "header": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*$"
              },
              "prefix": {
                "type": "string"
              }
            }
          }
        },
        "requires_primary_coding_environment": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-z][a-z0-9_]*$"
        }
      }
    },
    "imageGenerationCapabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reference_images",
        "image_edits",
        "background_removal",
        "transparent_background",
        "size_limits",
        "one_image_per_call",
        "alpha_verification",
        "fallback_if_no_alpha",
        "fallback_if_no_edits"
      ],
      "properties": {
        "reference_images": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "supported",
            "max_count",
            "notes"
          ],
          "properties": {
            "supported": {
              "type": "boolean"
            },
            "max_count": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1
            },
            "notes": {
              "type": "string"
            }
          }
        },
        "image_edits": {
          "type": "boolean"
        },
        "background_removal": {
          "type": "boolean"
        },
        "transparent_background": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "native",
            "request_parameter",
            "notes"
          ],
          "properties": {
            "native": {
              "type": "boolean"
            },
            "request_parameter": {
              "type": [
                "string",
                "null"
              ]
            },
            "notes": {
              "type": "string"
            }
          }
        },
        "size_limits": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "accepts_dimensions",
            "maximum_width_px",
            "maximum_height_px",
            "notes"
          ],
          "properties": {
            "accepts_dimensions": {
              "type": "boolean"
            },
            "maximum_width_px": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1
            },
            "maximum_height_px": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1
            },
            "maximum_pixels": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1
            },
            "notes": {
              "type": "string"
            }
          }
        },
        "one_image_per_call": {
          "const": true
        },
        "alpha_verification": {
          "type": "string",
          "minLength": 1
        },
        "fallback_if_no_alpha": {
          "type": "string",
          "minLength": 1
        },
        "fallback_if_no_edits": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "imageGenerationReferenceMcp": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "url",
        "maintenance",
        "authentication",
        "notes",
        "tool_names"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "maintenance": {
          "enum": [
            "official",
            "community"
          ]
        },
        "authentication": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        },
        "tool_names": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "mcpPlatformPin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "package_tree_sha256",
        "package_file_count",
        "runtime_entry_sha256",
        "runtime_entry_size",
        "package_symlinks"
      ],
      "properties": {
        "package_tree_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "package_file_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "runtime_entry_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "runtime_entry_size": {
          "type": "integer",
          "minimum": 1
        },
        "package_symlinks": {
          "type": "object",
          "maxProperties": 32,
          "propertyNames": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$",
            "maxLength": 256
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        }
      }
    }
  }
}
