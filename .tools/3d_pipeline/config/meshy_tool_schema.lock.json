  "optional_tools": {
    "meshy_text_to_motion": {
      "required_arguments": [
        "prompt",
        "duration"
      ],
      "optional_arguments": [
        "mode",
        "response_format"
      ],
      "paid": true,
      "input_schema": {
        "additionalProperties": false,
        "properties": {
          "duration": {
            "description": "Clip length in seconds: 2\u201310 in steps of 0.5.",
            "maximum": 10,
            "minimum": 2,
            "multipleOf": 0.5,
            "type": "number"
          },
          "mode": {
            "description": "'prime' (default): highest quality, FBX. 'swift': faster and cheaper, BVH.",
            "enum": [
              "prime",
              "swift"
            ],
            "type": "string"
          },
          "prompt": {
            "description": "The motion, e.g. 'jumps over a gap and lands in a crouch' (max 400 characters).",
            "maxLength": 400,
            "minLength": 1,
            "type": "string"
          },
          "response_format": {
