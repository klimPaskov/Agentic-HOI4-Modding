          },
          "input_task_id": {
            "description": "A SUCCEEDED task with a textured humanoid model",
            "minLength": 1,
            "type": "string"
          },
          "model_url": {
            "description": "Public URL of a textured humanoid .glb (max 400 MB), or a GLB data URI (max 100 MB)",
            "format": "uri",
            "type": "string"
