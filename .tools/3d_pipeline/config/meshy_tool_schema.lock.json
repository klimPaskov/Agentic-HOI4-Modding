  "required_tools": {
    "meshy_check_balance": {
      "required_arguments": [],
      "optional_arguments": [
        "response_format"
      ],
      "paid": false,
      "input_schema": {
        "additionalProperties": false,
        "properties": {
          "response_format": {
            "default": "markdown",
            "description": "markdown (default) or json",
            "enum": [
              "markdown",
              "json"
            ],
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    "meshy_image_to_3d": {
      "accepted_ai_models": [
        "meshy-6-lite",
        "meshy-6",
        "meshy-7",
        "meshy-7.1",
        "latest",
        "meshy-t2",
        "meshy-t2.5"
      ],
      "required_arguments": [],
      "required_argument_groups": [
        [
          "file_path",
          "image_url",
          "input_task_id"
        ]
      ],
      "input_image_exclusivity": [
        "file_path",
        "image_url",
        "input_task_id"
      ],
      "optional_arguments": [
        "ai_model",
        "alpha_thumbnail",
        "auto_size",
        "decimation_mode",
        "enable_pbr",
        "file_path",
        "geometry_resolution",
        "hd_texture",
        "image_enhancement",
        "image_url",
        "input_task_id",
        "model_type",
        "multi_view_thumbnails",
        "origin_at",
        "pose_mode",
        "remove_lighting",
        "response_format",
        "save_pre_remeshed_model",
        "should_remesh",
        "should_texture",
        "symmetry_mode",
        "target_formats",
        "target_polycount",
        "texture_image_url",
        "texture_prompt",
        "texture_resolution",
        "topology",
        "ultra_mode"
      ],
      "multi_view_thumbnails": false,
      "paid": true,
      "input_schema": {
        "additionalProperties": false,
        "properties": {
          "ai_model": {
            "anyOf": [
              {
                "enum": [
                  "meshy-6-lite",
                  "meshy-6",
                  "meshy-7",
                  "meshy-7.1",
                  "latest"
                ],
                "type": "string"
              },
              {
                "enum": [
                  "meshy-t2",
                  "meshy-t2.5"
                ],
                "type": "string"
              }
            ],
            "description": "'latest' (default, = Meshy 7.1) or 'meshy-7.1' (best), 'meshy-6', 'meshy-6-lite' (fast, cheap, 2K textures only); 'meshy-7' is deprecated. With model_type smart-topology: 'meshy-t2' (the default there) or 'meshy-t2.5' (newest, sharper detail for game assets)."
          },
          "alpha_thumbnail": {
            "description": "Also return a transparent-background preview (alpha_thumbnail_url).",
            "type": "boolean"
          },
          "auto_size": {
            "description": "AI-estimate the real-world height and resize to it (default false).",
            "type": "boolean"
          },
          "decimation_mode": {
            "description": "Adaptive decimation 1 (ultra) \u2013 4 (low); overrides target_polycount.",
            "maximum": 4,
            "minimum": 1,
            "type": "integer"
          },
          "enable_pbr": {
            "default": false,
            "description": "Also make metallic/roughness/normal maps.",
            "type": "boolean"
          },
          "file_path": {
            "description": "Absolute path to a local .jpg/.jpeg/.png/.webp; the server encodes it.",
            "type": "string"
          },
          "geometry_resolution": {
            "description": "Ultra geometry pass: standard (default), 2k or 4k (finest); meshy-7.1/latest with model_type standard only, +5 credits.",
            "enum": [
              "standard",
              "2k",
              "4k"
            ],
            "type": "string"
          },
          "hd_texture": {
            "description": "Deprecated: use texture_resolution '4k'.",
            "type": "boolean"
          },
          "image_enhancement": {
            "description": "Optimize the input image (meshy-6/7.1/latest); false keeps deliberate styling.",
            "type": "boolean"
          },
          "image_url": {
            "description": "Public image URL. For local files use file_path.",
            "type": "string"
          },
          "input_task_id": {
            "description": "A SUCCEEDED text-to-image / image-to-image task with exactly one image, used as the input.",
            "type": "string"
          },
          "model_type": {
            "description": "standard (default); smart-topology (ai_model meshy-t2 or meshy-t2.5): a clean, part-separated, triangle-only mesh made directly at target_polycount, ignoring remesh/decimation. lowpoly (Meshy T1) is retired: use smart-topology with meshy-t2.5.",
            "enum": [
              "standard",
              "smart-topology"
            ],
            "type": "string"
          },
          "multi_view_thumbnails": {
            "description": "Also return front/back/left/right thumbnails.",
            "type": "boolean"
          },
          "origin_at": {
            "description": "'bottom' or 'center' (default bottom with auto_size).",
            "enum": [
              "bottom",
              "center"
            ],
            "type": "string"
          },
          "pose_mode": {
            "description": "'a-pose' or 't-pose'; use 't-pose' when the model will be rigged or animated.",
            "enum": [
              "a-pose",
              "t-pose"
            ],
            "type": "string"
          },
          "remove_lighting": {
            "description": "Remove highlights/shadows from the base color (meshy-6 only; API default true there).",
            "type": "boolean"
          },
          "response_format": {
            "default": "markdown",
            "description": "markdown (default) or json",
            "enum": [
              "markdown",
              "json"
            ],
            "type": "string"
          },
          "save_pre_remeshed_model": {
            "description": "Also keep the GLB from before remeshing (with should_remesh).",
            "type": "boolean"
          },
          "should_remesh": {
            "description": "Remesh to target_polycount / topology (default false).",
            "type": "boolean"
          },
          "should_texture": {
            "description": "Generate textures (default true); false gives a cheaper untextured mesh.",
            "type": "boolean"
          },
          "symmetry_mode": {
            "description": "Deprecated: has no effect.",
            "enum": [
              "off",
              "auto",
              "on"
            ],
            "type": "string"
          },
          "target_formats": {
            "description": "Formats to produce (default: all but 3mf; list '3mf' to get it). Fewer formats finish faster.",
            "items": {
              "enum": [
                "glb",
                "obj",
                "fbx",
                "stl",
                "usdz",
                "3mf"
              ],
              "type": "string"
            },
            "type": "array"
          },
          "target_polycount": {
            "description": "Standard: remesh target 100\u2013300,000, needs should_remesh true. Smart Topology: meshy-t2 100\u201315,000 (default 4,000), meshy-t2.5 100\u201330,000 (default 15,000).",
            "maximum": 300000,
            "minimum": 100,
            "type": "integer"
          },
          "texture_image_url": {
            "description": "Image URL to guide texturing.",
            "format": "uri",
            "type": "string"
          },
          "texture_prompt": {
            "description": "Text to guide texturing (max 800 characters).",
            "maxLength": 800,
            "type": "string"
          },
          "texture_resolution": {
            "description": "Base color texture: 2k (default), 4k or 8k (+5 credits; PBR maps stay 4K, no emission map). 4k/8k not on meshy-6-lite.",
            "enum": [
              "2k",
              "4k",
              "8k"
            ],
            "type": "string"
          },
          "topology": {
            "description": "quad or triangle (default).",
            "enum": [
              "quad",
              "triangle"
            ],
            "type": "string"
          },
          "ultra_mode": {
            "description": "Deprecated: use geometry_resolution '2k'.",
            "type": "boolean"
          }
        },
        "type": "object"
      }
    },
    "meshy_get_task_status": {
