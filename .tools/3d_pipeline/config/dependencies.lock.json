{
  "schema_version": "1.0.0",
  "lock_name": "hoi4-3d-model-pipeline",
  "bootstrap": ".tools/3d_pipeline/bootstrap_3d_workflow.py",
  "routes": {
    "meshy_mcp": {
      "package": "@meshy-ai/meshy-mcp-server",
      "version": "0.4.0",
      "required_environment": ["MESHY_API_KEY"]
    },
    "blender_lab_mcp": {
      "repository": "https://projects.blender.org/lab/blender_mcp.git",
      "tag": "v1.0.0",
      "commit": "03004fd0216bfe5e0a3d9ac9b47d5efadc3d78c4",
      "server_version": "1.28.1",
      "wrapper": ".tools/3d_pipeline/wrappers/run_blender_lab_mcp.cmd"
    },
    "blender": {
      "minimum_version": "5.1.0",
      "required_minor": "5.1"
    },
    "io_pdx_mesh": {
      "release": "0.91",
      "version": "0.91.0",
      "download_url": "https://github.com/ross-g/io_pdx_mesh/releases/download/0.91/blender-io_pdx_mesh.zip",
      "sha256": "A683DF08318CB700014C7FE9A3D15139E5FB2313C7E98715204263E48931F7C2",
      "installed_extension_id": "io_pdx_mesh"
    }
  },
  "policy": {
    "provider_input_image_count": 1,
    "allow_meshy_multiview_thumbnails": false,
    "paid_generation_attempts_per_pilot": 1,
    "retry_paid_calls": false,
    "runtime_sources_must_not_reference_docs_assets": true
  }
}
