{
 "comment": "Family contract for build_shelf.py. dirs = 'game-relative folder::filename regex' (recursive; a leading '=' means this folder only). canvas = accepted native canvases. ideas/advisor_cards/portrait = classification sources (common/ideas, common/characters).",
 "families": [
  {"id": "focus", "folder": "icons/national_focus", "k": 18, "dirs": ["gfx/interface/goals::^(goal|focus)"], "exclude": "untitl", "canvas": ["100x88"], "kind": "gfx"},
  {"id": "idea_spirit", "folder": "icons/ideas", "k": 18, "dirs": ["gfx/interface/ideas::^idea_"], "ideas": ["country"], "exclude_ideas": ["political_advisor", "high_command", "theorist", "army_chief", "air_chief", "navy_chief", "industrial_concern", "materiel_manufacturer", "aircraft_manufacturer", "naval_manufacturer", "tank_manufacturer"], "canvas": ["60x68"], "classification_note": "textures used by ideas in common/ideas category 'country' (country national spirits), not used by advisor or manufacturer categories"},
  {"id": "idea_concern", "folder": "icons/idea_concerns", "dirs": ["gfx/interface/ideas::."], "ideas": ["industrial_concern", "materiel_manufacturer", "aircraft_manufacturer", "naval_manufacturer", "tank_manufacturer"], "exclude_ideas": ["political_advisor", "high_command", "theorist", "army_chief", "air_chief", "navy_chief"], "canvas": ["64x64"], "classification_note": "industrial concerns and the four manufacturer categories in common/ideas"},
  {"id": "officer_corps_spirit", "folder": "icons/officer_corps_spirits", "dirs": ["gfx/interface/officer_corp/spirits"], "canvas": ["45x45"]},
  {"id": "decision", "folder": "icons/decisions", "k": 18, "dirs": ["gfx/interface/decisions::^decision_(?!cat)"], "canvas": ["33x32"], "notes": "decisions and missions share these icons (GFX_decision_*)"},
  {"id": "decision_category_icon", "folder": "icons/decision_categories", "dirs": ["gfx/interface/decisions::^decision_category"], "canvas": ["52x40"]},
  {"id": "state_modifier", "folder": "icons/state_modifiers", "dirs": ["gfx/interface/state_modifiers"], "canvas": ["32x32"], "notes": "GFX_modifiers_* used by dynamic and state modifiers"},
  {"id": "special_project_icon", "folder": "icons/special_projects", "dirs": ["gfx/interface/special_project/project_icons"], "canvas": ["161x98"]},
  {"id": "raid", "folder": "icons/military_raids", "dirs": ["gfx/interface/military_raids::^raid_(target|type|unit)_"], "canvas": ["32x32"], "notes": "raid target, type and unit map icons; the button and frame backgrounds in the same folder are excluded"},
  {"id": "mio_department", "folder": "icons/military_industrial_organizations", "dirs": ["gfx/interface/military_industrial_organization/department_icons"], "registered": true, "canvas": ["48x48"]},
  {"id": "mio_trait", "folder": "icons/mio_traits", "dirs": ["gfx/interface/military_industrial_organization/trait_icons"], "canvas": ["48x48"]},
  {"id": "mio_policy", "folder": "icons/mio_policies", "dirs": ["gfx/interface/military_industrial_organization/policy_icons"], "canvas": ["60x60"]},
  {"id": "bop_side", "folder": "icons/balance_of_power", "dirs": ["gfx/interface/bop"], "canvas": ["72x88"]},
  {"id": "medal", "folder": "icons/medals", "dirs": ["gfx/interface/medals"], "canvas": ["16x28"], "notes": "single-medal textures; the 112x42 and 224x84 ribbon strips and the 28x42 large medals are other canvases"},
  {"id": "agency_upgrade", "folder": "icons/intelligence_agency", "dirs": ["gfx/interface/operatives/icons"], "canvas": ["68x68"]},
  {"id": "agency_logo", "folder": "icons/agency_logos", "dirs": ["gfx/interface/operatives/agencies"], "canvas": ["234x119", "233x119"], "canvas_labels": {"234x119": "agency logo, 2 frames", "233x119": "agency logo, 2 frames (1 px narrower variant)"}},
  {"id": "operation_icon", "folder": "icons/intelligence_operations", "k": 18, "dirs": ["gfx/interface/operations"], "canvas": ["85x85", "59x58"], "canvas_k": {"85x85": 9, "59x58": 9}, "canvas_labels": {"85x85": "operation icon", "59x58": "operation phase icon (phase_*_small)"}, "notes": "operation icons (85x85) and operation phase icons (59x58)"},
  {"id": "commander_trait", "folder": "icons/commander_traits", "dirs": ["=gfx/interface/traits::^trait_"], "canvas": ["23x33"]},
  {"id": "personal_trait", "folder": "icons/personal_traits", "dirs": ["gfx/interface/traits/personal"], "canvas": ["23x33"]},
  {"id": "doctrine", "folder": "icons/doctrines", "dirs": ["gfx/interface/doctrines::^doctrine_"], "canvas": ["64x64"]},
  {"id": "report_event", "folder": "event_art/report", "k": 18, "dirs": ["gfx/event_pictures::^report_event"], "canvas": ["210x176"], "notes": "the 209x176, 208x176, 210x177 and 217x183 variants are excluded; vanilla card+shadow template is 210x176"},
  {"id": "news_event", "folder": "event_art/news", "k": 18, "dirs": ["gfx/event_pictures::^news_event"], "canvas": ["397x153"]},
  {"id": "decision_category_picture", "folder": "icons/decision_categories/pictures", "dirs": ["gfx/interface/decisions::^decision_cat_"], "canvas": ["114x101"]},
  {"id": "operation_picture", "folder": "event_art/operation", "dirs": ["gfx/interface/operations::^phase_(?!.*_small)"], "canvas": ["210x176"]},
  {"id": "technology", "folder": "icons/technologies", "k": 18, "dirs": ["gfx/interface/technologies"], "canvas": ["146x54", "64x64"], "canvas_k": {"146x54": 12, "64x64": 6}, "canvas_labels": {"146x54": "equipment technology picture (_medium style)", "64x64": "technology icon"}},
  {"id": "achievement", "folder": "icons/achievements", "dirs": ["gfx/achievements::^(?!.*(_grey|_not_eligible))"], "canvas": ["64x64"], "nation": false, "notes": "base (completed) icons only; the _grey and _not_eligible variants are generated by the achievement workflow; the template folder is left untouched"},
  {"id": "leader_portrait", "folder": "portraits/leaders", "k": 18, "dirs": ["gfx/leaders"], "portrait": "leader", "canvas": ["156x210"], "nation_cap": 2},
  {"id": "commander_portrait", "folder": "portraits/commanders", "k": 18, "dirs": ["gfx/leaders"], "portrait": "commander", "canvas": ["156x210"], "nation_cap": 2},
  {"id": "operative_portrait", "folder": "portraits/operatives", "dirs": ["gfx/leaders"], "portrait": "operative", "canvas": ["156x210"], "nation_cap": 2},
  {"id": "scientist_portrait", "folder": "portraits/scientists", "dirs": ["gfx/leaders"], "portrait": "scientist", "canvas": ["156x210"], "nation_cap": 2},
  {"id": "advisor_card", "folder": "portraits/advisors", "dirs": ["gfx/interface/ideas::."], "ideas": ["political_advisor", "high_command", "theorist", "army_chief", "air_chief", "navy_chief"], "advisor_cards": true, "canvas": ["65x67"], "nation_cap": 3, "classification_note": "advisor textures: ideas in the six advisor categories plus advisor idea_token sprites from common/characters"},
  {"id": "flag", "folder": "flags", "k": 18, "nation_cap": 1, "dirs": ["=gfx/flags"], "canvas": ["82x52"],
   "variants": [
     {"subfolder": "normal", "dirs": ["=gfx/flags"], "canvas": ["82x52"]},
     {"subfolder": "medium", "dirs": ["gfx/flags/medium"], "canvas": ["41x26"]},
     {"subfolder": "small", "dirs": ["gfx/flags/small"], "canvas": ["10x7"]}],
   "notes": "one set of tags: every selected file exists at all three sizes (large=normal 82x52, medium 41x26, small 10x7)"},
  {"id": "counter_large", "folder": "units/land/counters_large", "dirs": ["gfx/interface/counters/divisions_large"], "canvas": ["152x42"], "nation": false, "frame_note": "152x42 = two 76x42 frames"},
  {"id": "counter_small", "folder": "units/land/map_counters", "dirs": ["gfx/interface/counters/divisions_small"], "canvas": ["60x12"], "frame_note": "60x12 = two 30x12 frames"},
  {"id": "counter_small_air", "folder": "units/air/map_counters", "dirs": ["gfx/interface/counters/air_small"], "exclude": "_inverted$", "canvas": ["60x12"], "nation": false, "notes": "sub-split of counter_small for air; _inverted twins excluded"},
  {"id": "counter_small_naval", "folder": "units/naval/map_counters", "dirs": ["gfx/interface/counters/ships_small"], "exclude": "_inverted$", "canvas": ["30x12"], "nation": false, "notes": "sub-split of counter_small for ships; _inverted twins excluded"},
  {"id": "division_emblem", "folder": "units/land/division_template_emblems", "dirs": ["gfx/interface/counters/division_templates_large"], "canvas": ["76x42"], "nation": false},
  {"id": "building", "folder": "icons/buildings", "dirs": ["gfx/interface/buildings"], "canvas": ["128x64"], "nation": false, "frame_note": "128x64 = two 64x64 frames"},
  {"id": "faction_logo", "folder": "icons/factions", "dirs": ["gfx/interface/factions/faction_logos"], "exclude": "_miniature$", "canvas": ["200x100"], "frame_note": "200x100 = two 100x100 frames"},
  {"id": "modifier_stat_icon", "folder": "icons/modifiers", "dirs": ["gfx/interface/modifiers::^MODIFIER_"], "canvas": ["30x20"], "nation": false}
 ]
}
