# Local HOI4 launcher/workshop files
/descriptor.mod
/thumbnail.png

# Generated by the optional autonomous 3D bootstrap; do not commit machine-local caches or runtime records.
/.tools/3d_pipeline/vendor/
/.tools/3d_pipeline/**/__pycache__/
/.tools/3d_pipeline/adapter/.venv/
/.tools/3d_pipeline/adapter/uv.lock
/.tools/3d_pipeline/config/runtime.json
/.tools/3d_pipeline/config/meshy_mcp_version.txt
/.tools/3d_pipeline/config/blender_mcp_project.txt
/.tools/3d_pipeline/config/uv_executable.txt
/.tools/3d_pipeline/config/blender_mcp_host.txt
/.tools/3d_pipeline/config/blender_mcp_port.txt

# Generated Python bytecode from reusable skill tools.
/.claude/skills/**/__pycache__/
/.claude/skills/**/.mypy_cache/
/.tools/image_generation/**/__pycache__/
/.tools/image_generation/**/.venv/
# hoi4-imagegen release binaries, installed per machine the way HOI4 Mod Setup installs them.
/.tools/image_generation/hoi4-imagegen/

# Only Claude Code and Codex live at the root of the source package. Skill
# copies are generated from .claude/skills by .tools/sync/sync_skills.py, and
# the other clients' files are kept in .tools/clients/. HOI4 Mod Setup installs
# each at its real place in a mod, so a copy generated here stays local.
/.agents/
/.augment/
/.clinerules/
/.continue/
/.cursor/
/.devin/
/.gemini/
/.github/instructions/
/.grok/
/.kilo/
/.kiro/
/.opencode/
/.qoder/
/.qwen/
/.vscode/
/.aider.conf.yml
/GEMINI.md
/opencode.json
*.pyc

# Claude Code project definitions are tracked; personal overrides are not.
/.claude/settings.local.json

# Machine-local settings written by HOI4 Mod Setup or `check.py doctor --save-game-dir`, and task scratch space.
/.tools/local_settings.json
/.tmp/
